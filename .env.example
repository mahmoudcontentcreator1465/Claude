# Copy to .env.local for local development, or add these in Vercel → Project → Settings → Environment Variables.

# Public site URL, used for canonical URLs, hreflang, sitemap and Open Graph.
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Draft / Pending content (placeholder case studies, unconfirmed clients and services) is shown
# automatically in `npm run dev` and on Vercel Preview deployments, and never on Vercel Production.
# Leave empty for that default; "false" hides drafts everywhere, "true" shows them everywhere.
SHOW_DRAFT_CONTENT=

# ── Contact form (Resend) ─────────────────────────────────────────────
# Delivery stays OFF until CONTACT_DELIVERY_ENABLED=true AND the three values below are set.
# While off, the form validates normally and tells visitors their message was NOT sent.
CONTACT_DELIVERY_ENABLED=false
RESEND_API_KEY=
# Where inquiries arrive (comma-separate several addresses).
CONTACT_TO_EMAIL=
# Must be on a domain verified in Resend, e.g. "Different Website <website@your-domain.com>".
CONTACT_FROM_EMAIL=

# ── Optional: Cloudflare Turnstile (extra spam protection) ─────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
